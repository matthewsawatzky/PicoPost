#!/usr/bin/env bash
# PicoPost development helper.
#
#   ./dev start      start API + demo, create dev config if missing
#   ./dev stop       stop processes started by ./dev start
#   ./dev restart    stop then start
#   ./dev status     show what is running
#   ./dev logs [api|demo]   follow logs (optionally one process)
#   ./dev db clean [--yes]  reset the development database
#   ./dev db info    show database information
#   ./dev test       run Go tests
#   ./dev build      build ./bin/picopost
#
# Works on macOS and Linux. No Docker required.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

API_PORT=8080
DEMO_PORT=8081
API_URL="http://127.0.0.1:${API_PORT}"
DEMO_URL="http://127.0.0.1:${DEMO_PORT}"

DATA_DIR="$ROOT/data"
BIN_DIR="$ROOT/bin"
RUN_DIR="$ROOT/.dev"
DEV_CONFIG="$ROOT/picopost.toml"
DEV_DB="$DATA_DIR/dev.db"
API_LOG="$RUN_DIR/api.log"
DEMO_LOG="$RUN_DIR/demo.log"
API_PID_FILE="$RUN_DIR/api.pid"
DEMO_PID_FILE="$RUN_DIR/demo.pid"

log() { printf '\033[1;34m%s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m%s\033[0m\n' "$*" >&2; }
die() { printf '\033[1;31m%s\033[0m\n' "$*" >&2; exit 1; }

# --- process helpers -------------------------------------------------------

pid_of() { # pid_file -> pid or empty
  local f="$1"
  if [[ -f "$f" ]]; then
    cat "$f"
  fi
}

is_running() { # pid -> 0 if running
  local pid="$1"
  [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null
}

stop_pid_file() { # name pid_file
  local name="$1" f="$2" pid
  pid="$(pid_of "$f")"
  if is_running "$pid"; then
    log "stopping $name (PID $pid)"
    kill "$pid" 2>/dev/null || true
    for _ in $(seq 1 50); do
      is_running "$pid" || break
      sleep 0.1
    done
    if is_running "$pid"; then
      warn "$name did not stop gracefully; sending SIGKILL"
      kill -9 "$pid" 2>/dev/null || true
    fi
  fi
  rm -f "$f"
}

# --- commands --------------------------------------------------------------

cmd_start() {
  mkdir -p "$DATA_DIR" "$BIN_DIR" "$RUN_DIR"

  if [[ ! -f "$DEV_CONFIG" ]]; then
    log "creating development config $DEV_CONFIG"
    cat > "$DEV_CONFIG" <<EOF
[server]
listen = "127.0.0.1:${API_PORT}"

[storage]
database = "./data/dev.db"

[cors]
origins = [
  "http://127.0.0.1:${DEMO_PORT}",
  "http://localhost:${DEMO_PORT}",
]

[posts]
max_body_bytes = 1024
max_text_bytes = 768
max_metadata_bytes = 256
max_metadata_keys = 16
max_key_length = 32
max_urls_per_post = 5
page_size = 50

[identity]
anonymous = true
browser = true

[rate_limit]
posts_per_minute = 20
trust_forwarded = false

[filters.username]
deny = ["admin", "administrator", "moderator", "system"]

[filters.text]
deny = ["blocked phrase", "spam.example"]
EOF
  fi

  if ! command -v go >/dev/null 2>&1; then
    die "go is required but was not found on PATH"
  fi

  log "building picopost"
  go build -o "$BIN_DIR/picopost" ./cmd/picopost
  log "building demo server"
  go build -o "$BIN_DIR/demo" ./cmd/demo

  if is_running "$(pid_of "$API_PID_FILE")"; then
    warn "API already running (PID $(pid_of "$API_PID_FILE")); skipping"
  else
    log "starting API"
    "$BIN_DIR/picopost" serve --config "$DEV_CONFIG" >> "$API_LOG" 2>&1 &
    echo $! > "$API_PID_FILE"
  fi

  if is_running "$(pid_of "$DEMO_PID_FILE")"; then
    warn "demo already running (PID $(pid_of "$DEMO_PID_FILE")); skipping"
  else
    log "starting demo site"
    "$BIN_DIR/demo" -listen "127.0.0.1:${DEMO_PORT}" -dir "$ROOT/web" >> "$DEMO_LOG" 2>&1 &
    echo $! > "$DEMO_PID_FILE"
  fi

  # Wait for the API to come up.
  for _ in $(seq 1 50); do
    if curl -fsS "$API_URL/health" >/dev/null 2>&1; then
      break
    fi
    sleep 0.1
  done

  echo
  log "PicoPost development environment"
  echo
  echo "API:"
  echo "  $API_URL"
  echo
  echo "Demo:"
  echo "  $DEMO_URL"
  echo
  echo "Database:"
  echo "  $DEV_DB"
  echo
  echo "Use:"
  echo "  ./dev logs"
  echo "  ./dev status"
  echo "  ./dev stop"
}

cmd_stop() {
  stop_pid_file "API" "$API_PID_FILE"
  stop_pid_file "demo" "$DEMO_PID_FILE"
  log "stopped"
}

cmd_status() {
  local api_pid demo_pid api_health db_posts db_idents
  api_pid="$(pid_of "$API_PID_FILE")"
  demo_pid="$(pid_of "$DEMO_PID_FILE")"

  if is_running "$api_pid"; then
    printf 'PicoPost API      running PID %s\n' "$api_pid"
  else
    printf 'PicoPost API      stopped\n'
  fi
  if is_running "$demo_pid"; then
    printf 'Demo server       running PID %s\n' "$demo_pid"
  else
    printf 'Demo server       stopped\n'
  fi

  if is_running "$api_pid" && curl -fsS "$API_URL/health" >/dev/null 2>&1; then
    api_health="OK"
  else
    api_health="DOWN"
  fi
  printf 'API health        %s\n' "$api_health"

  printf 'Database          %s\n' "$DEV_DB"
  if [[ -f "$DEV_DB" ]]; then
    db_posts="$("$BIN_DIR/picopost" check --config "$DEV_CONFIG" 2>/dev/null | sed -n 's/.*, \([0-9]*\) posts.*/\1/p' || echo "?")"
    db_idents="$("$BIN_DIR/picopost" check --config "$DEV_CONFIG" 2>/dev/null | sed -n 's/.*, \([0-9]*\) identities.*/\1/p' || echo "?")"
    printf 'Posts             %s\n' "${db_posts:-?}"
    printf 'Identities        %s\n' "${db_idents:-?}"
  else
    printf 'Posts             (no database yet)\n'
    printf 'Identities        (no database yet)\n'
  fi
}

cmd_logs() {
  local which="${1:-all}"
  case "$which" in
    api) tail -f "$API_LOG" ;;
    demo) tail -f "$DEMO_LOG" ;;
    all)
      tail -f "$API_LOG" "$DEMO_LOG" 2>/dev/null || tail -f "$API_LOG"
      ;;
    *) die "usage: ./dev logs [api|demo]" ;;
  esac
}

cmd_db_clean() {
  local yes=0
  if [[ "${1:-}" == "--yes" ]]; then
    yes=1
  fi
  if [[ ! -f "$DEV_DB" ]]; then
    log "no development database at $DEV_DB; nothing to clean"
    return
  fi
  if [[ "$yes" -ne 1 ]]; then
    read -r -p "Delete development database $DEV_DB? [y/N] " answer
    case "$answer" in
      y|Y|yes) ;;
      *) log "aborted"; return ;;
    esac
  fi
  stop_pid_file "API" "$API_PID_FILE"
  rm -f "$DEV_DB" "$DEV_DB-wal" "$DEV_DB-shm"
  log "development database deleted (migrations will run on next start)"
}

cmd_db_info() {
  local db="$DEV_DB"
  if [[ ! -f "$db" ]]; then
    log "no development database yet at $db"
    return
  fi
  local size schema posts idents oldest newest
  size="$(du -h "$db" | cut -f1)"
  schema="$("$BIN_DIR/picopost" check --config "$DEV_CONFIG" 2>/dev/null | sed -n 's/.*schema v\([0-9]*\).*/\1/p' || echo "?")"
  posts="$("$BIN_DIR/picopost" check --config "$DEV_CONFIG" 2>/dev/null | sed -n 's/.*, \([0-9]*\) posts.*/\1/p' || echo "?")"
  idents="$("$BIN_DIR/picopost" check --config "$DEV_CONFIG" 2>/dev/null | sed -n 's/.*, \([0-9]*\) identities.*/\1/p' || echo "?")"
  printf 'path:      %s\n' "$db"
  printf 'file size: %s\n' "$size"
  printf 'schema:    v%s\n' "${schema:-?}"
  printf 'posts:     %s\n' "${posts:-?}"
  printf 'identities: %s\n' "${idents:-?}"
  if command -v sqlite3 >/dev/null 2>&1; then
    printf 'oldest:    %s\n' "$(sqlite3 "$db" 'SELECT datetime(MIN(created_at), "unixepoch") FROM posts;' 2>/dev/null || echo "n/a")"
    printf 'newest:    %s\n' "$(sqlite3 "$db" 'SELECT datetime(MAX(created_at), "unixepoch") FROM posts;' 2>/dev/null || echo "n/a")"
  fi
}

cmd_test() {
  log "running Go tests"
  go test ./...
}

cmd_build() {
  mkdir -p "$BIN_DIR"
  log "building ./bin/picopost"
  go build -o "$BIN_DIR/picopost" ./cmd/picopost
  log "building ./bin/demo"
  go build -o "$BIN_DIR/demo" ./cmd/demo
  log "done"
}

# --- dispatch --------------------------------------------------------------

case "${1:-}" in
  start) cmd_start ;;
  stop) cmd_stop ;;
  restart) cmd_stop; cmd_start ;;
  status) cmd_status ;;
  logs) cmd_logs "${2:-all}" ;;
  db)
    case "${2:-}" in
      clean) cmd_db_clean "${3:-}" ;;
      info) cmd_db_info ;;
      *) die "usage: ./dev db [clean|info]" ;;
    esac
    ;;
  test) cmd_test ;;
  build) cmd_build ;;
  *)
    cat <<'EOF'
PicoPost development helper

Usage:
  ./dev start       start API + demo site (creates dev config if missing)
  ./dev stop        stop processes started by ./dev start
  ./dev restart     stop then start
  ./dev status      show running processes and database state
  ./dev logs [api|demo]  follow logs
  ./dev db clean [--yes] reset the development database
  ./dev db info     show database information
  ./dev test        run Go tests
  ./dev build       build ./bin/picopost
EOF
    ;;
esac
